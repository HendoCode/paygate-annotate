{
  "manifest_version": 3,
  "name": "Paygate Annotate",
  "version": "0.1.0",
  "description": "Mark links to sites you'd rather not visit (paywalls etc.) with your own styles, via the right-click menu.",
  "permissions": ["contextMenus", "storage"],
  "background": { "service_worker": "src/background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/lib/core.js", "src/lib/store.js", "src/content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": { "default_title": "Paygate Annotate: edit rules & styles" },
  "options_ui": { "page": "src/options.html", "open_in_tab": true }
}
